<style>
  @font-face { font-family: "GS"; src: url("file:///home/dell/projects-hub/pixel-craft-folio-96/public/fonts/general-sans-400.woff2") format("woff2"); font-weight: 400; }
  @font-face { font-family: "GS"; src: url("file:///home/dell/projects-hub/pixel-craft-folio-96/public/fonts/general-sans-500.woff2") format("woff2"); font-weight: 500; }
  @font-face { font-family: "GS"; src: url("file:///home/dell/projects-hub/pixel-craft-folio-96/public/fonts/general-sans-600.woff2") format("woff2"); font-weight: 600; }
  @page { size: A4; margin: 10mm 13mm 10mm 13mm; }
  :root { --ink: #0b1f3a; --muted: #4a5568; --accent: #9c6410; --rule: #d5dbe4; --link: #1a4f8b; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "GS", "Helvetica Neue", Arial, sans-serif; font-size: 9.2pt; line-height: 1.4; color: var(--ink); background: #fff; }
  a { color: inherit; text-decoration: none; }
  header { border-bottom: 2px solid var(--ink); padding-bottom: 7px; margin-bottom: 4px; }
  h1 { font-size: 21pt; font-weight: 600; margin: 0; line-height: 1.1; }
  .headline { font-size: 11pt; font-weight: 500; color: var(--accent); margin: 3px 0 5px; }
  .contact { font-size: 8.6pt; color: var(--muted); display: flex; flex-wrap: wrap; gap: 1px 13px; }
  .contact a { color: var(--link); }
  h2 { font-size: 10pt; font-weight: 600; color: var(--ink); border-bottom: 1px solid var(--rule); padding-bottom: 2px; margin: 12px 0 6px; }
  p { margin: 0 0 2px; }
  ul { margin: 2px 0 0; padding-left: 14px; }
  li { margin: 0 0 2px; }
  .item { margin-bottom: 9px; break-inside: avoid; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .title { font-weight: 600; font-size: 10pt; }
  .org { font-weight: 500; }
  .meta { color: var(--muted); font-size: 8.6pt; white-space: nowrap; }
  .type { color: var(--muted); font-weight: 400; }
  .links { font-size: 8.5pt; margin: 1px 0 1px; }
  .links a, a.ul { color: var(--link); text-decoration: underline; text-underline-offset: 1.5px; }
  .tech { font-size: 8.5pt; color: var(--muted); margin-top: 2px; }
  .label { font-weight: 600; color: var(--ink); }
  .compact { margin-bottom: 8px; break-inside: avoid; }
  .skills { display: grid; grid-template-columns: 128px 1fr; gap: 3px 10px; margin: 0; }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0; }
</style>
